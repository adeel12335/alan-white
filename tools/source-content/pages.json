[{"id":547,"date":"2026-07-14T16:40:31","date_gmt":"2026-07-14T22:10:31","guid":{"rendered":"https:\/\/structural-systematicphilosophy.com\/?page_id=547"},"modified":"2026-07-14T16:40:34","modified_gmt":"2026-07-14T22:10:34","slug":"recent-posts","status":"publish","type":"page","link":"https:\/\/structural-systematicphilosophy.com\/recent-posts\/","title":{"rendered":"Recent Posts"},"content":{"rendered":"","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-547","page","type-page","status-publish","hentry"],"_hostinger_reach_plugin_has_subscription_block":false,"_hostinger_reach_plugin_is_elementor":false,"_links":{"self":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/547","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/comments?post=547"}],"version-history":[{"count":1,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/547\/revisions"}],"predecessor-version":[{"id":549,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/547\/revisions\/549"}],"wp:attachment":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/media?parent=547"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":493,"date":"2025-12-17T15:34:39","date_gmt":"2025-12-17T21:04:39","guid":{"rendered":"https:\/\/structural-systematicphilosophy.com\/?page_id=493"},"modified":"2025-12-17T15:35:15","modified_gmt":"2025-12-17T21:05:15","slug":"publications","status":"publish","type":"page","link":"https:\/\/structural-systematicphilosophy.com\/publications\/","title":{"rendered":"Publications"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"493\" class=\"elementor elementor-493\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d72103a e-flex e-con-boxed e-con e-parent\" data-id=\"d72103a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-904033d elementor-widget elementor-widget-text-editor\" data-id=\"904033d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Some links for selected publications; for a complete list, see my <a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2012\/12\/AW-CV-122012.pdf\">CV<\/a>. For all my books, take a look at <a href=\"http:\/\/www.amazon.com\/Alan-White\/e\/B001HOFDZA\/ref=sr_ntt_srch_lnk_3?qid=1426976717&amp;sr=8-3\">my Amazon author page<\/a>.<\/p><p>&#8220;Being.&#8221; Internet Encyclopedia of Philosophy. https:\/\/iep.utm.edu\/being\/<\/p><p>&#8220;<a href=\"http:\/\/sites.williams.edu\/awhite\/white-2020-sex-and-beauty-for-birds-frogs-and-humans\/\">Sex and Beauty for Birds, Frogs, and Humans<\/a>.&#8221;<\/p><p><a href=\"http:\/\/sites.williams.edu\/awhite\/white-2020-if-you-can-understand-this-essay-then-you-have-moral-rights-and-moral-duties-open-philosophy\/\">&#8220;If You Can Understand This Article, Then You Have Moral Rights and Moral Duties.&#8221;<\/a>\u00a0<em>Open Philosophy<\/em>, 2020:3.<\/p><p><a href=\"https:\/\/doi.org\/10.1515\/opphil-2019-0037\">&#8220;Toward a Systematic, Rights-Based Moral Theory<\/a>.&#8221;\u00a0<em>Open Philosophy<\/em>, 2019:2.<\/p><p><em><a href=\"http:\/\/www.amazon.com\/Toward-Philosophical-Theory-Everything-Structural-Systematic\/dp\/1623567181\/ref=sr_1_1?s=books&amp;ie=UTF8&amp;qid=1426973868&amp;sr=1-1&amp;keywords=toward+a+philosophical+theory+of+everything\">Toward a Philosophical Theory of Everything. Contributions to the Structural-Systematic Philosophy<\/a><\/em>. Bloomsbury (formerly Continuum), 2014.<\/p><p>For a mere $2.99, get the Kindle edition of my novel<em> <a href=\"http:\/\/www.amazon.com\/Nothing-Matters-Philosophical-Romance-ebook\/dp\/B0057J5DLK\/ref=sr_1_1?ie=UTF8&amp;qid=1315144271&amp;sr=8-1\">Nothing Matters. A Philosophical Romance<\/a>,<\/em> which involves Proust, Nietzsche, and Schopenhauer.<\/p><p>Also or instead, for a paltry $2.99, get the Kindle edition of my novel<em> <a href=\"http:\/\/www.amazon.com\/Revenge-ebook\/dp\/B0057PFPIA\/ref=ntt_at_ep_dpt_6\">Revenge<\/a>.<\/em><em> \u00a0 <\/em><\/p><p><a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2013\/01\/White-2003-An-Appalling-or-Banal-Reality.pdf\">&#8220;An Appalling or Banal Reality,&#8221;<\/a> an article published in 2003 about the Jorge Luis Borges story &#8220;Tl\u00f6n, Uqbar, Orbis Tertius&#8221;; o, en espan\u00f5l, <a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2013\/01\/White-2006-Una-realidad-atroz-o-banal.pdf\">&#8220;<em>Una Realidad Atroz o Banal.&#8221;<\/em><\/a><\/p><p>&#8220;<a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2013\/01\/White-1991-The-End-of-Philosophy.pdf\">The End of Philosophy<\/a>&#8220;, a lecture I presented to a general audience in 1991.<\/p><p><em><a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2013\/01\/White-1990-Within-Nietzsches-Labyrinth.pdf\">Within Nietzsche&#8217;s Labyrinth<\/a><\/em>, Routledge, 1990.<\/p><p>&#8220;<a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2013\/01\/White-1988-The-Insignificant-Other.pdf\">The Insignificant Other:\u00a0Towards a Postmodern Aristotelian Humanism&#8221;<\/a>, written for a Williams College faculty seminar, &#8220;The Problem of the Other,&#8221; 1988.<\/p><p><em><a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2012\/12\/White-1983-AK.pdf\">Absolute Knowledge. Hegel and the Problem of Metaphysics<\/a><\/em>. Ohio UP, 1983.<\/p><p><em><a href=\"http:\/\/sites.williams.edu\/awhite\/files\/2012\/12\/White-1983-Schelling.pdf\">Schelling. An Introduction to the System of Freedom<\/a><\/em>. Yale UP, 1983.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Some links for selected publications; for a complete list, see my CV. For all my books, take a look at my Amazon author page. &#8220;Being.&#8221; Internet Encyclopedia of Philosophy. https:\/\/iep.utm.edu\/being\/ &#8220;Sex and Beauty for Birds, Frogs, and Humans.&#8221; &#8220;If You Can Understand This Article, Then You Have Moral Rights and Moral Duties.&#8221;\u00a0Open Philosophy, 2020:3. &#8220;Toward [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-493","page","type-page","status-publish","hentry"],"_hostinger_reach_plugin_has_subscription_block":false,"_hostinger_reach_plugin_is_elementor":false,"_links":{"self":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/493","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/comments?post=493"}],"version-history":[{"count":7,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/493\/revisions"}],"predecessor-version":[{"id":501,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/493\