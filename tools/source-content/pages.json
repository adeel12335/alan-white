n 2024, I collaborated with Lorenz B. Puntel (Professor Emeritus, Munich) on [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-427","page","type-page","status-publish","hentry"],"_hostinger_reach_plugin_has_subscription_block":false,"_hostinger_reach_plugin_is_elementor":false,"_links":{"self":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/427","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/comments?post=427"}],"version-history":[{"count":22,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/427\/revisions"}],"predecessor-version":[{"id":462,"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/pages\/427\/revisions\/462"}],"wp:attachment":[{"href":"https:\/\/structural-systematicphilosophy.com\/wp-json\/wp\/v2\/media?parent=427"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}]